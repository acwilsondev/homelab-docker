{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Denver",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "helm-values": {
    "managerFilePatterns": [
      "/^k8s/apps/[^/]+/values\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^k8s/apps/[^/]+/application\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates.",
      "matchManagers": ["helm-values", "argocd"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Major updates always open a PR for manual review.",
      "matchManagers": ["helm-values", "argocd"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "vikunja-tagger's tag is a commit SHA set by its own CI pipeline, not a version Renovate should try to bump.",
      "matchManagers": ["helm-values"],
      "matchPackageNames": ["ghcr.io/acwilsondev/vikunja-tagger"],
      "enabled": false
    }
  ]
}
